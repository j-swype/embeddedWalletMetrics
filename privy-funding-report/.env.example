# ── Privy Credentials (required) ──
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# ── Chain Configuration ──
# Comma-separated list of chains to scan (default: ethereum,arbitrum,base,optimism,polygon)
# Available: ethereum, arbitrum, base, optimism, polygon
CHAINS=ethereum,arbitrum,base,optimism,polygon

# Per-chain RPC URL overrides (uppercase chain name).
# Defaults to public LlamaRPC endpoints. Override for reliability/rate limits.
# CHAIN_RPC_URL_ETHEREUM=https://eth.llamarpc.com
# CHAIN_RPC_URL_ARBITRUM=https://arbitrum.llamarpc.com
# CHAIN_RPC_URL_BASE=https://base.llamarpc.com
# CHAIN_RPC_URL_OPTIMISM=https://optimism.llamarpc.com
# CHAIN_RPC_URL_POLYGON=https://polygon-bor-rpc.publicnode.com

# ── Performance Tuning ──
# Delay between RPC calls in milliseconds (default: 200).
# Increase if you hit rate limits on public RPC endpoints.
RPC_DELAY_MS=200
